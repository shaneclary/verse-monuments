# Commerce Configuration
# Set to 'links' for external product URLs, or 'shopify' for Buy Button embed
NEXT_PUBLIC_BUY_MODE=links

# Shopify Configuration (only needed if BUY_MODE=shopify)
NEXT_PUBLIC_SHOPIFY_DOMAIN=
NEXT_PUBLIC_SHOPIFY_BUY_BUTTON_ID=

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_SCRIPT=

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://verse-monuments.vercel.app

# Supabase Configuration (from mothership backend)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database Connection (PostgreSQL direct connection - for migrations/admin)
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
